{
    "name": "personal",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "prettier ./src --write --config ./.prettierrc",
        "precommit": "lint-staged",
        "prepare": "husky install",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint ."
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.23",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-icons": "^5.7.0",
        "react-router-dom": "^7.18.2",
        "react-slick": "^0.31.0",
        "react-tabs": "^6.1.1",
        "react-tooltip": "^6.0.8",
        "sass": "^1.102.0",
        "slick-carousel": "^1.8.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "vite": "^8.2.1"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": [
            "prettier --write --config ./.prettierrc"
        ]
